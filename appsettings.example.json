{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "JwtSettings": {
    "SecretKey": "REPLACE_WITH_YOUR_SECRET_KEY_HERE",
    "Issuer": "ThisApp",
    "Audience": "ThisAppUsers",
    "ExpiryMinutes": 60
  },
  "DatabaseSettings": {
    "ConnectionString": "Data Source=authnetexample.db"
  },
  "OAuthSettings": {
    "Github": {
      "ClientId": "YOUR_GITHUB_CLIENT_ID",
      "ClientSecret": "YOUR_GITHUB_CLIENT_SECRET"
    }
  },
  "AllowedHosts": "*"
}
